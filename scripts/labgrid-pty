#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Bridge a labgrid console to stdin/stdout.

Intended as Twister's ``serial_pty`` script (and the pytest-twister-harness
``--device-serial-pty``): Twister starts this with a pty on its stdio and
talks to it as if it were a serial port. We forward everything to the
console driver of the labgrid target.

Usage: labgrid-pty [-e ENV] [-p PLACE] [-l LOGFILE]
  ENV   defaults to $ZEPHYR_LABGRID_ENV (then $LG_ENV)
  PLACE defaults to $LG_PLACE

Exit codes: 0 on stdin EOF or SIGTERM, 1 on a labgrid error, 2 on usage.
"""

import argparse
import os
import select
import signal
import sys
import threading
import traceback


def die(msg, code=1):
    print(f'labgrid-pty: {msg}', file=sys.stderr, flush=True)
    sys.exit(code)


def reset_rts(console):
    """Pulse RTS (EN on ESP32 dev kits) through the pyserial object of a
    SerialDriver. Works over RFC2217 when ser2net forwards modem control."""
    import time
    ser = getattr(console, 'serial', None)
    if ser is None:
        die('--reset-rts needs a SerialDriver console')
    try:
        ser.dtr = False
        ser.rts = True
        time.sleep(0.1)
        ser.rts = False
    except Exception as e:
        die(f'RTS reset failed: {e}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('-e', '--env', default=os.environ.get('ZEPHYR_LABGRID_ENV')
                        or os.environ.get('LG_ENV'))
    parser.add_argument('-p', '--place', default=os.environ.get('LG_PLACE'))
    parser.add_argument('-l', '--logfile', default=None,
                        help='also append raw console output to this file')
    parser.add_argument('--reset-rts', action='store_true',
                        help='pulse RTS after connecting to reset boards whose '
                             'reset line is wired to RTS (USB-UART ESP32 kits)')
    args = parser.parse_args()
    if not args.env or not args.place:
        parser.error('need --env/$ZEPHYR_LABGRID_ENV and --place/$LG_PLACE')

    os.environ['LG_PLACE'] = args.place
    try:
        from labgrid import Environment
        from labgrid.exceptions import NoDriverFoundError, NoResourceFoundError
        from pexpect import TIMEOUT
    except ImportError as e:
        die(f'python package missing: {e}')

    if os.environ.get('LG_PTY_NO_PURGE'):
        # Workaround for ser2net 4.6.0 (Ubuntu 24.04) never answering the
        # RFC2217 PURGE request, see labgrid issue #1396. pyserial would
        # otherwise time out in open(). Disable until ser2net is upgraded.
        import serial.rfc2217
        serial.rfc2217.Serial.reset_input_buffer = lambda self: None
        serial.rfc2217.Serial.reset_output_buffer = lambda self: None

    try:
        env = Environment(config_file=args.env)
        target = env.get_target()
        console = target.get_driver('ConsoleProtocol')
    except NoResourceFoundError as e:
        die(f'place "{args.place}" has no matching resource: {e}. '
            'Is the place acquired by you and the exporter running?')
    except NoDriverFoundError:
        die(f'no ConsoleProtocol driver (e.g. SerialDriver) in {args.env}')
    except Exception as e:
        die(f'could not open console of place "{args.place}": {e}')

    if args.reset_rts:
        reset_rts(console)

    stop = threading.Event()
    failure = []
    out = sys.stdout.buffer
    log = open(args.logfile, 'ab') if args.logfile else None

    def reader():
        while not stop.is_set():
            try:
                data = console.read(size=1, timeout=0.2, max_size=4096)
            except TIMEOUT:
                continue
            except Exception as e:  # connection lost: stop, do not spin
                failure.append(f'console read failed: {type(e).__name__}: {e}')
                stop.set()
                return
            out.write(data)
            out.flush()
            if log:
                log.write(data)
                log.flush()

    def on_term(signum, frame):
        stop.set()

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    signal.signal(signal.SIGHUP, on_term)

    t = threading.Thread(target=reader, daemon=True)
    t.start()

    stdin_fd = sys.stdin.fileno()
    write_warned = False
    try:
        while not stop.is_set():
            r, _, _ = select.select([stdin_fd], [], [], 0.2)
            if stdin_fd in r:
                try:
                    data = os.read(stdin_fd, 4096)
                except OSError:
                    break
                if not data:
                    break
                try:
                    console.write(data)
                except Exception as e:
                    # Keep the console alive: a lost connection shows up in
                    # the reader. Report the first failed write once.
                    if not write_warned:
                        write_warned = True
                        print(f'labgrid-pty: console write failed: '
                              f'{type(e).__name__}: {e}', file=sys.stderr, flush=True)
                        traceback.print_exc(file=sys.stderr)
    finally:
        stop.set()
        t.join(timeout=1.0)
        try:
            target.cleanup()
        finally:
            if log:
                log.close()

    if failure:
        die(failure[0])


if __name__ == '__main__':
    main()
