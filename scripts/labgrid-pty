# Wrapper so the tool works straight from a checkout without pip install.
# The same entry point is installed as a console script by pyproject.toml.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from zephyr_labgrid.pty import main  # noqa: E402

if __name__ == '__main__':
    main()
